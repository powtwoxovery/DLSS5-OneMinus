#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 8
#endif

Texture2D<float4> InputColor;
RWTexture2D<float4> OutputColor;
int2 InputOffset;
int2 OutputSize;

Texture2D SceneDepth;
Texture2D SceneVelocity;
RWTexture2D<float2> OutputMotion;
uint VelocityIsValid;
float4x4 MotionClipToPrevClip;
uint UseMotionClipOverride;

Texture2D<float4> OriginalColor;
SamplerState OriginalSampler;
Texture2D<float4> ModelColor;
SamplerState ModelSampler;
float Strength;
float WhitePoint;
uint CompositionMode;
uint DebugView;
float SliceOffset;
int2 OutputOffset;

float3 DifferenceView(float3 Original, float3 Neural)
{
    return saturate(abs(Neural - Original) * 4.0);
}

float3 LinearToSrgb(float3 Value)
{
    Value = saturate(Value);
    return lerp(Value * 12.92, 1.055 * pow(max(Value, 1.0e-8), 1.0 / 2.4) - 0.055, step(0.0031308, Value));
}

float3 SrgbToLinear(float3 Value)
{
    Value = saturate(Value);
    return lerp(Value / 12.92, pow((Value + 0.055) / 1.055, 2.4), step(0.04045, Value));
}

float3 SoftKnee(float3 Value)
{
    const float Luminance = dot(Value, float3(0.2126, 0.7152, 0.0722));
    if (Luminance > 0.75)
    {
        const float Rolled = 0.75 + 0.25 * (1.0 - exp(-(Luminance - 0.75) / 0.25));
        Value *= Rolled / max(Luminance, 1.0e-6);
    }

    const float Peak = max(Value.r, max(Value.g, Value.b));
    if (Peak > 1.0)
    {
        Value /= Peak;
    }
    return Value;
}

float GetSliceCoordinate(float Slice)
{
    return SliceOffset <= 0.000001 ? Slice : frac(Slice - SliceOffset);
}

bool IsSliceDivider(float Slice, float HalfLine)
{
    if (abs(Slice - 1.0 / 3.0) <= HalfLine || abs(Slice - 2.0 / 3.0) <= HalfLine)
    {
        return true;
    }
    return SliceOffset > 0.000001 && min(Slice, 1.0 - Slice) <= HalfLine;
}

float3 ApplyDebugView(float3 Original, float3 Neural, float2 UV, float2 Size)
{
    float3 Difference = DifferenceView(Original, Neural);
    if (DebugView == 1)
    {
        return Difference;
    }
    if (DebugView == 2)
    {
        const float Slope = 0.363970234;
        float Slice = GetSliceCoordinate(UV.x + Slope * (Size.y / max(Size.x, 1.0)) * (UV.y - 0.5));
        float HalfLine = 1.0 / max(Size.x, 1.0);
        if (IsSliceDivider(Slice, HalfLine))
        {
            return 0.0;
        }
        return Slice < 1.0 / 3.0 ? Original : (Slice < 2.0 / 3.0 ? Neural : Difference);
    }
    return Neural;
}

#if DLSS5_ONEMINUS_ENCODE
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void DisplayEncodeMain(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)OutputSize))
    {
        return;
    }
    float4 Source = InputColor.Load(int3((int2)DispatchThreadId.xy + InputOffset, 0));
    OutputColor[DispatchThreadId.xy] = float4(saturate(Source.rgb), 1.0);
}
#endif

#if DLSS5_ONEMINUS_HDR_ENCODE
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void HDREncodeMain(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)OutputSize))
    {
        return;
    }
    float4 Source = InputColor.Load(int3((int2)DispatchThreadId.xy + InputOffset, 0));
    float3 Normalized = max(Source.rgb, 0.0) / max(WhitePoint, 0.001);
    OutputColor[DispatchThreadId.xy] = float4(LinearToSrgb(SoftKnee(Normalized)), 1.0);
}
#endif

#if DLSS5_ONEMINUS_MOTION_GUIDE
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void MotionGuideMain(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)OutputSize))
    {
        return;
    }

    uint2 SourcePixel = DispatchThreadId.xy + InputOffset;
    float Depth = SceneDepth.Load(int3(SourcePixel, 0)).x;
    float2 ScreenMotion = 0.0;
    float4 EncodedVelocity = VelocityIsValid != 0
        ? SceneVelocity.Load(int3(SourcePixel, 0))
        : 0.0;

    if (VelocityIsValid != 0 && EncodedVelocity.x > 0.0)
    {
        ScreenMotion = DecodeVelocityFromTexture(EncodedVelocity).xy;
    }
    else
    {
        float4 CurrentClip;
        CurrentClip.xy = SvPositionToScreenPosition(float4(SourcePixel + 0.5, 0.0, 1.0)).xy;
        CurrentClip.z = Depth;
        CurrentClip.w = 1.0;
        float4 PreviousClip = UseMotionClipOverride != 0
            ? mul(CurrentClip, MotionClipToPrevClip) : mul(CurrentClip, View.ClipToPrevClip);
        if (PreviousClip.w > 0.0)
        {
            ScreenMotion = CurrentClip.xy - PreviousClip.xy / PreviousClip.w;
        }
    }

    // Convert UE screen-space motion to NR pixel-space motion and place the
    // tightly packed guide at the top left of its dedicated texture.
    OutputMotion[DispatchThreadId.xy] = ScreenMotion * float2(-0.5, 0.5) * OutputSize;
}
#endif


#if DLSS5_ONEMINUS_HDR_RESOLVE
void HDRResolveMain(
    in noperspective float4 UVAndScreenPosition : TEXCOORD0,
    in float4 Position : SV_Position,
    out float4 OutColor : SV_Target0)
{
    float2 ViewUV = (Position.xy - (float2)OutputOffset) / max((float2)OutputSize, 1.0);
    float4 Original = OriginalColor.SampleLevel(OriginalSampler, UVAndScreenPosition.xy, 0);
    float3 Model = ModelColor.SampleLevel(ModelSampler, ViewUV, 0).rgb;
    float SafeWhite = max(WhitePoint, 0.001);
    float3 NormalizedOriginal = SoftKnee(max(Original.rgb, 0.0) / SafeWhite);
    float3 LinearModel = SrgbToLinear(Model);
    float3 Additive = max(Original.rgb + (LinearModel - NormalizedOriginal) * SafeWhite, 0.0);
    float3 Ratio = clamp(LinearModel / max(NormalizedOriginal, 0.02), 0.5, 2.0);
    float3 RatioResult = max(Original.rgb * Ratio, 0.0);
    float3 RatioWeight = smoothstep(0.02, 0.10, NormalizedOriginal);
    float3 Composed = CompositionMode == 0
        ? Additive
        : lerp(Additive, RatioResult, RatioWeight);
    // composition strength 0..2 (default 1); >1 extrapolates the NR edit; HDR result kept non-negative.
    float3 Neural = max(lerp(Original.rgb, Composed, clamp(Strength, 0.0, 2.0)), 0.0);

    float3 Difference = abs(Neural - Original.rgb);
    if (DebugView == 1)
    {
        Neural = Difference * 4.0;
    }
    else if (DebugView == 2)
    {
        const float Slope = 0.363970234;
        float Slice = GetSliceCoordinate(ViewUV.x + Slope * (OutputSize.y / max((float)OutputSize.x, 1.0)) * (ViewUV.y - 0.5));
        float HalfLine = 1.0 / max((float)OutputSize.x, 1.0);
        if (IsSliceDivider(Slice, HalfLine))
        {
            Neural = 0.0;
        }
        else
        {
            Neural = Slice < 1.0 / 3.0 ? Original.rgb : (Slice < 2.0 / 3.0 ? Neural : Difference * 4.0);
        }
    }
    OutColor = float4(Neural, Original.a);
}
#endif

// Multi-view consistency. NR's edit is split into a low-frequency tone field and a
// high-frequency detail field, both as per-channel log ratios in linear light.
// The view's own tone can then be replaced by a shared reference tone so that
// neighbouring views of a multi-view render agree at their seams.
#if DLSS5_ONEMINUS_CONSISTENCY_LOG_RATIO || DLSS5_ONEMINUS_CONSISTENCY_RESOLVE
static const float ConsistencyMaxLogRatio = 1.386294; // ratio clamp 0.25..4

float3 ConsistencyLinearOriginal(float3 Original, uint bDisplayDomain, float SafeWhite)
{
    return bDisplayDomain != 0
        ? SrgbToLinear(Original)
        : SoftKnee(max(Original, 0.0) / SafeWhite);
}

float3 ConsistencyLogRatio(float3 Original, float3 Model, uint bDisplayDomain, float SafeWhite)
{
    const float Floor = 0.002;
    float3 LinearOriginal = ConsistencyLinearOriginal(Original, bDisplayDomain, SafeWhite);
    float3 LinearModel = SrgbToLinear(Model);
    return clamp(log((LinearModel + Floor) / (LinearOriginal + Floor)), -ConsistencyMaxLogRatio, ConsistencyMaxLogRatio);
}
#endif

#if DLSS5_ONEMINUS_CONSISTENCY_LOG_RATIO
Texture2D<float4> ConsModelColor;
uint ConsDisplayDomain;
float ConsWhitePoint;

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ConsistencyLogRatioMain(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)OutputSize))
    {
        return;
    }
    float3 Original = InputColor.Load(int3((int2)DispatchThreadId.xy + InputOffset, 0)).rgb;
    float3 Model = ConsModelColor.Load(int3(DispatchThreadId.xy, 0)).rgb;
    OutputColor[DispatchThreadId.xy] = float4(
        ConsistencyLogRatio(Original, Model, ConsDisplayDomain, max(ConsWhitePoint, 0.001)), 1.0);
}
#endif

#if DLSS5_ONEMINUS_CONSISTENCY_DOWNSAMPLE
uint ConsFactor;
int2 ConsSourceSize;

// Box-filters the full-resolution log ratio into the low-resolution tone grid.
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ConsistencyDownsampleMain(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)OutputSize))
    {
        return;
    }
    int2 Base = (int2)DispatchThreadId.xy * (int)ConsFactor;
    float3 Sum = 0.0;
    float Count = 0.0;
    for (uint Y = 0; Y < ConsFactor; ++Y)
    {
        for (uint X = 0; X < ConsFactor; ++X)
        {
            int2 Pixel = Base + int2(X, Y);
            if (all(Pixel < ConsSourceSize))
            {
                Sum += InputColor.Load(int3(Pixel, 0)).rgb;
                Count += 1.0;
            }
        }
    }
    OutputColor[DispatchThreadId.xy] = float4(Sum / max(Count, 1.0), 1.0);
}
#endif

#if DLSS5_ONEMINUS_CONSISTENCY_BLUR
int2 ConsDirection;
float ConsSigma;
int ConsRadius;

// One separable Gaussian pass; edges clamp so the tone is not pulled towards black.
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ConsistencyBlurMain(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= (uint2)OutputSize))
    {
        return;
    }
    float InvTwoSigmaSq = 1.0 / (2.0 * ConsSigma * ConsSigma);
    float3 Sum = 0.0;
    float WeightSum = 0.0;
    for (int Offset = -ConsRadius; Offset <= ConsRadius; ++Offset)
    {
        int2 Pixel = clamp((int2)DispatchThreadId.xy + ConsDirection * Offset, int2(0, 0), OutputSize - 1);
        float Weight = exp(-(float)(Offset * Offset) * InvTwoSigmaSq);
        Sum += InputColor.Load(int3(Pixel, 0)).rgb * Weight;
        WeightSum += Weight;
    }
    OutputColor[DispatchThreadId.xy] = float4(Sum / max(WeightSum, 1.0e-6), 1.0);
}
#endif

#if DLSS5_ONEMINUS_CONSISTENCY_RESOLVE
Texture2D<float4> ConsLogRatio;
Texture2D<float4> ConsViewTone;
SamplerState ConsLinearSampler;
Texture2D<float4> ConsReferenceTone;
Texture2D<float4> ConsReferenceMap;
uint ConsMode;            // 1 = reference tone, 2 = detail only
uint ConsHasReference;
uint ConsDisplayDomain;
uint ConsDebug;           // 0 off, 1 view tone, 2 detail, 3 reference tone, 4 reference validity
float ConsWhitePoint;

float3 ConsistencyVisualizeLog(float3 Value)
{
    return saturate(0.5 + Value * 0.5);
}

void ConsistencyResolveMain(
    in noperspective float4 UVAndScreenPosition : TEXCOORD0,
    in float4 Position : SV_Position,
    out float4 OutColor : SV_Target0)
{
    float2 ViewUV = (Position.xy - (float2)OutputOffset) / max((float2)OutputSize, 1.0);
    float4 Original = OriginalColor.SampleLevel(OriginalSampler, UVAndScreenPosition.xy, 0);
    float3 LogRatio = ConsLogRatio.SampleLevel(ModelSampler, ViewUV, 0).rgb;
    float3 ViewTone = ConsViewTone.SampleLevel(ConsLinearSampler, ViewUV, 0).rgb;
    float3 Detail = LogRatio - ViewTone;

    float3 Tone = ViewTone;
    float Validity = 0.0;
    float3 ReferenceTone = 0.0;
    if (ConsHasReference != 0)
    {
        float4 Map = ConsReferenceMap.SampleLevel(ConsLinearSampler, ViewUV, 0);
        Validity = saturate(Map.a);
        ReferenceTone = ConsReferenceTone.SampleLevel(ConsLinearSampler, Map.rg, 0).rgb;
    }
    if (ConsMode == 1)
    {
        // Outside the reference's valid domain the view keeps its own tone.
        Tone = lerp(ViewTone, ReferenceTone, Validity);
    }
    else if (ConsMode == 2)
    {
        Tone = 0.0;
    }

    float3 Gain = exp(clamp(Tone + Detail, -ConsistencyMaxLogRatio, ConsistencyMaxLogRatio));
    float SafeWhite = max(ConsWhitePoint, 0.001);
    float3 Neural;
    if (ConsDisplayDomain != 0)
    {
        float3 Edited = LinearToSrgb(SrgbToLinear(Original.rgb) * Gain);
        Neural = saturate(lerp(Original.rgb, Edited, clamp(Strength, 0.0, 2.0)));
    }
    else
    {
        float3 Edited = max(Original.rgb * Gain, 0.0);
        Neural = max(lerp(Original.rgb, Edited, clamp(Strength, 0.0, 2.0)), 0.0);
    }

    if (ConsDebug == 1)
    {
        Neural = ConsistencyVisualizeLog(ViewTone);
    }
    else if (ConsDebug == 2)
    {
        Neural = ConsistencyVisualizeLog(Detail * 4.0);
    }
    else if (ConsDebug == 3)
    {
        Neural = ConsistencyVisualizeLog(ReferenceTone);
    }
    else if (ConsDebug == 4)
    {
        Neural = float3(1.0 - Validity, Validity, 0.0);
    }
    else
    {
        Neural = ApplyDebugView(Original.rgb, Neural, ViewUV, (float2)OutputSize);
    }
    OutColor = float4(Neural, Original.a);
}
#endif

#if DLSS5_ONEMINUS_POST_TONE_RESOLVE
void PostToneResolveMain(
    in noperspective float4 UVAndScreenPosition : TEXCOORD0,
    in float4 Position : SV_Position,
    out float4 OutColor : SV_Target0)
{
    float2 ViewUV = (Position.xy - (float2)OutputOffset) / max((float2)OutputSize, 1.0);
    float4 Original = OriginalColor.SampleLevel(OriginalSampler, UVAndScreenPosition.xy, 0);
    float3 Model = ModelColor.SampleLevel(ModelSampler, ViewUV, 0).rgb;
    // composition strength 0..2 (default 1); >1 extrapolates the NR edit; display-space result kept in 0..1.
    float3 Neural = saturate(lerp(Original.rgb, Model, clamp(Strength, 0.0, 2.0)));
    OutColor = float4(ApplyDebugView(Original.rgb, Neural, ViewUV, (float2)OutputSize), Original.a);
}
#endif
